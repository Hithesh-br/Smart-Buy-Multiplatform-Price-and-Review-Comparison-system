# ==============================================================================
# SmartBuy Production Environment Variables Template (.env.example)
# IMPORTANT: Copy this file to .env and configure real credentials.
# NEVER commit .env to version control!
# ==============================================================================

# --- Server & Core Application ---
PORT=5000
SECRET_KEY=generate_a_random_secure_hex_key_for_production
BASE_URL=https://your-production-app.domain.com
CORS_ORIGINS=https://your-production-app.domain.com,https://your-frontend.vercel.app

# --- Database (MongoDB Atlas / Self-Hosted) ---
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# For local Docker: mongodb://mongo:27017
MONGO_URI=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=smartbuy

# --- SMTP Email Configuration (Alerts & OTP Authentication) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME=SmartBuy

# --- Authentication & OTP Rules ---
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=7

# --- AI & Comparison Intelligence (Optional) ---
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Scraper Architecture & Runtime Controls ---
SCRAPER_HEADLESS=true
SCRAPER_CACHE_ENABLED=true
SCRAPER_TIMEOUT=45000
SCRAPER_RETRIES=2
PAGE_TIMEOUT=18000
NAVIGATION_TIMEOUT=18000

# --- Marketplace External APIs (Optional Level 1 Provider Overrides) ---
# Amazon Creator / Affiliate API
AMAZON_API_URL=
AMAZON_API_KEY=
AMAZON_PARTNER_TAG=

# Flipkart Affiliate API
FLIPKART_API_URL=
FLIPKART_API_KEY=
FLIPKART_AFFILIATE_ID=

# Meesho Provider API
MEESHO_API_URL=
MEESHO_API_KEY=
MEESHO_TIMEOUT_MS=45000
MEESHO_MAX_RESULTS=10
MEESHO_CACHE_TTL=120
